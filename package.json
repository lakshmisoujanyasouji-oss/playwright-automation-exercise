{
  "name": "rdts-automation-2026",
  "version": "0.1.0",
  "description": "Production-grade Playwright + TypeScript automation framework with UI, API, Database and AI-enhanced testing",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "test":          "npx playwright test",
    "test:headed":   "npx playwright test --headed",
    "test:smoke":    "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep @regression",
    "test:ui":       "npx playwright test tests/auth/ tests/products/",
    "test:api":      "npx playwright test tests/api/api.spec.ts",
    "test:db":       "npx playwright test tests/db/",
    "test:mock":     "npx playwright test tests/api/apiMock.spec.ts",
    "test:debug":    "npx playwright test --debug",
    "test:ci":       "npx playwright test --reporter=github",
    "test:ai":       "npx ts-node --project tsconfig.json ai/testAI.ts",
    "report":        "npx playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "e2e-testing",
    "api-testing",
    "ai-testing",
    "ci-cd",
    "sqlite",
    "page-object-model"
  ],
  "author": "Lakshmi Soujanya",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}